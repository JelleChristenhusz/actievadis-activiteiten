@page "/gebruikers"
@rendermode InteractiveServer
@layout UI.Components.Layout.AppLayout
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using Shared.DTOs
@using UI.Service
@inject IHttpClientFactory HttpClientFactory
@inject JwtTokenStore TokenStore
@inject NavigationManager Navigation
@inject ILogger<GebruikersBeheren> Logger

<PageTitle>Gebruikers beheren</PageTitle>

<main class="users-page">
    <header class="page-header">
        <div>
            <span class="eyebrow">Beheer</span>
            <h1>Gebruikers</h1>
            <p>Maak accounts aan, wijzig ze of verwijder ze.</p>
        </div>
    </header>

    @if (_loading)
    {
        <p class="state-message">Gebruikers worden geladen…</p>
    }
    else if (_forbidden)
    {
        <div class="notice notice-error" role="alert">Je hebt geen beheerderrechten om gebruikers te beheren.</div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="notice notice-error" role="alert">@_error</div>
        }
        @if (!string.IsNullOrWhiteSpace(_success))
        {
            <div class="notice notice-success" role="status">@_success</div>
        }

        <section class="panel create-panel">
            <div class="panel-heading">
                <div>
                    <h2>Gebruiker toevoegen</h2>
                    <p>De gebruiker kan met dit wachtwoord direct inloggen.</p>
                </div>
            </div>

            <EditForm Model="_newUser" OnValidSubmit="CreateUserAsync" FormName="create-user">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="form-grid">
                    <div class="field">
                        <label for="user-name">Naam</label>
                        <InputText id="user-name" class="form-control" @bind-Value="_newUser.Name" autocomplete="name" />
                        <ValidationMessage For="@(() => _newUser.Name)" />
                    </div>
                    <div class="field">
                        <label for="user-job-title">Functie</label>
                        <InputSelect id="user-job-title" class="form-select" @bind-Value="_newUser.JobTitle">
                            <option value="">Kies een functie</option>
                            @foreach (var jobTitle in _jobTitles)
                            {
                                <option value="@jobTitle.Name">@jobTitle.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _newUser.JobTitle)" />
                    </div>
                    <div class="field">
                        <label for="user-email">E-mailadres</label>
                        <InputText id="user-email" type="email" class="form-control" @bind-Value="_newUser.Email" autocomplete="email" />
                        <ValidationMessage For="@(() => _newUser.Email)" />
                    </div>
                    <div class="field">
                        <label for="user-password">Tijdelijk wachtwoord</label>
                        <InputText id="user-password" type="password" class="form-control" @bind-Value="_newUser.Password" autocomplete="new-password" />
                        <small>Minimaal 8 tekens.</small>
                        <ValidationMessage For="@(() => _newUser.Password)" />
                    </div>
                </div>
                <div class="form-actions">
                    <button class="primary-button" type="submit" disabled="@_saving">@(_saving ? "Bezig met opslaan…" : "Gebruiker aanmaken")</button>
                </div>
            </EditForm>
        </section>

        <section class="panel users-panel">
            <div class="panel-heading">
                <div>
                    <h2>Bestaande gebruikers</h2>
                    <p>Pas naam, e-mailadres of functie aan met Wijzigen, of verwijder een account.</p>
                </div>
                <span class="user-count">@_users.Count @(_users.Count == 1 ? "gebruiker" : "gebruikers")</span>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr><th>Naam</th><th>Functie</th><th>E-mailadres</th><th>Rechten</th><th><span class="visually-hidden">Acties</span></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var user in _users)
                        {
                            <tr @key="user.Id">
                                <td data-label="Naam">
                                    <strong>@user.Name</strong>
                                    @if (user.Id == _currentUserId)
                                    {
                                        <span class="you-badge">jij</span>
                                    }
                                </td>
                                <td data-label="Functie">@user.JobTitle</td>
                                <td data-label="E-mailadres">@user.Email</td>
                                <td data-label="Rechten">
                                    <span class="role-badge @(IsAdministrator(user) ? "role-admin" : null)">@RoleLabel(user.Role.Name)</span>
                                </td>
                                <td class="row-actions">
                                    <button class="secondary-button" type="button" aria-label="@user.Name wijzigen" @onclick="() => StartEdit(user)">Wijzigen</button>
                                    @* You cannot delete your own account. *@
                                    @if (user.Id != _currentUserId)
                                    {
                                        <button class="danger-button" type="button" aria-label="@user.Name verwijderen" @onclick="() => StartDelete(user)">Verwijderen</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</main>

@if (_editing is not null)
{
    <div class="dialog-backdrop">
        <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="edit-title">
            <h2 id="edit-title">@_editing.Name wijzigen</h2>

            <EditForm Model="_editForm" OnValidSubmit="SaveEditAsync" FormName="edit-user">
                <DataAnnotationsValidator />
                <div class="dialog-fields">
                    <div class="field">
                        <label for="edit-name">Naam</label>
                        <InputText id="edit-name" class="form-control" @bind-Value="_editForm.Name" />
                        <ValidationMessage For="@(() => _editForm.Name)" />
                    </div>
                    <div class="field">
                        <label for="edit-email">E-mailadres</label>
                        <InputText id="edit-email" type="email" class="form-control" @bind-Value="_editForm.Email" />
                        <ValidationMessage For="@(() => _editForm.Email)" />
                    </div>
                    <div class="field">
                        <label for="edit-job-title">Functie</label>
                        @* Changing your own job title would take away your own administrator rights. *@
                        <InputSelect id="edit-job-title" class="form-select" @bind-Value="_editForm.JobTitle" disabled="@(_editing.Id == _currentUserId)">
                            @foreach (var jobTitle in _jobTitles)
                            {
                                <option value="@jobTitle.Name">@jobTitle.Name</option>
                            }
                        </InputSelect>
                        @if (_editing.Id == _currentUserId)
                        {
                            <small>Je eigen functie kan alleen een andere beheerder wijzigen.</small>
                        }
                        <ValidationMessage For="@(() => _editForm.JobTitle)" />
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_editError))
                {
                    <div class="notice notice-error" role="alert">@_editError</div>
                }

                <div class="dialog-actions">
                    <button class="secondary-button" type="button" disabled="@_saving" @onclick="CancelEdit">Annuleren</button>
                    <button class="primary-button" type="submit" disabled="@_saving">@(_saving ? "Bezig met opslaan…" : "Opslaan")</button>
                </div>
            </EditForm>
        </section>
    </div>
}

@if (_deleting is not null)
{
    <div class="dialog-backdrop">
        <section class="dialog dialog-danger" role="alertdialog" aria-modal="true" aria-labelledby="delete-title" aria-describedby="delete-description">
            <h2 id="delete-title">@_deleting.Name verwijderen?</h2>
            <div id="delete-description">
                <p>@_deleting.Name kan daarna niet meer inloggen en verdwijnt uit alle lijsten.</p>
                <ul>
                    <li>Inschrijvingen voor activiteiten die nog moeten beginnen vervallen; die plekken komen vrij.</li>
                    <li>Eerdere deelnames blijven bewaard.</li>
                    <li>Het e-mailadres kan daarna opnieuw worden gebruikt voor een nieuw account.</li>
                </ul>
            </div>

            @if (!string.IsNullOrWhiteSpace(_deleteError))
            {
                <div class="notice notice-error" role="alert">@_deleteError</div>
            }

            <div class="dialog-actions">
                <button class="secondary-button" type="button" disabled="@_saving" @onclick="CancelDelete">Annuleren</button>
                <button class="danger-button danger-solid" type="button" disabled="@_saving" @onclick="DeleteUserAsync">@(_saving ? "Bezig met verwijderen…" : "Ja, verwijderen")</button>
            </div>
        </section>
    </div>
}

<style>
    .users-page { max-width: 1120px; margin: 0 auto; padding: 42px 24px 64px; color: #1d1d3b; }
    .page-header { margin-bottom: 26px; }
    .eyebrow { color: #7b5d13; font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .page-header h1 { margin: 5px 0; font-size: 2.1rem; font-weight: 750; }
    .page-header p, .panel-heading p { margin: 0; color: #687083; }
    .panel { margin-top: 22px; padding: 24px; border: 1px solid #e7e9ef; border-radius: 14px; background: white; box-shadow: 0 5px 20px #1d1d3b0a; }
    .panel-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 22px; }
    .panel-heading h2 { margin: 0 0 4px; font-size: 1.25rem; }
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 22px; }
    .field { display: flex; flex-direction: column; gap: 6px; }
    .field label { font-weight: 650; }
    .field small { min-height: 1.2em; color: #687083; }
    .form-control, .form-select { min-height: 44px; border: 1px solid #cfd3dd; border-radius: 8px; padding: 9px 11px; }
    .form-select:disabled { background-color: #f4f4f7; color: #687083; cursor: not-allowed; }
    .form-actions { display: flex; justify-content: flex-end; margin-top: 22px; }
    .primary-button, .secondary-button, .danger-button { border-radius: 8px; padding: 11px 18px; font-weight: 650; cursor: pointer; }
    .primary-button { border: 0; background: #1d1d3b; color: white; }
    .primary-button:hover:not(:disabled) { background: #34345d; }
    .secondary-button { border: 1px solid #dddded; background: #efeff7; color: #43436b; }
    .secondary-button:hover:not(:disabled) { background: #e4e4f0; color: #1d1d3b; }
    .danger-button { border: 1px solid #edcdd1; background: #fff; color: #b43b45; }
    .danger-button:hover:not(:disabled) { background: #fff0f1; color: #9b2630; }
    .danger-button.danger-solid { border-color: #b43b45; background: #b43b45; color: white; }
    .danger-button.danger-solid:hover:not(:disabled) { background: #9b2630; color: white; }
    .primary-button:disabled, .secondary-button:disabled, .danger-button:disabled { opacity: .6; cursor: wait; }
    .primary-button:focus-visible, .secondary-button:focus-visible, .danger-button:focus-visible { outline: 3px solid #f5a623; outline-offset: 3px; }
    .users-panel { padding-bottom: 8px; }
    .user-count { border-radius: 999px; background: #f0eff7; color: #34345d; padding: 6px 11px; font-size: .85rem; font-weight: 650; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 14px 12px; border-bottom: 1px solid #eceef3; text-align: left; vertical-align: middle; }
    th { color: #687083; font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; }
    .row-actions { text-align: right; white-space: nowrap; }
    .row-actions button { padding: 8px 13px; font-size: .88rem; }
    .row-actions button + button { margin-left: 8px; }
    .you-badge { margin-left: 8px; border-radius: 999px; background: #f0eff7; color: #43436b; padding: 2px 8px; font-size: .75rem; font-weight: 650; }
    .role-badge { display: inline-block; border-radius: 999px; background: #f0eff7; color: #43436b; padding: 4px 10px; font-size: .82rem; font-weight: 650; }
    .role-badge.role-admin { background: #fff0d7; color: #725016; }
    .notice { margin: 15px 0; padding: 13px 16px; border-radius: 8px; }
    .notice-error { background: #fff0f0; color: #a32222; }
    .notice-success { background: #eaf8ef; color: #176b36; }
    .state-message { color: #687083; }
    .dialog-backdrop { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgba(29, 29, 59, .45); }
    .dialog { width: min(520px, 100%); max-height: calc(100vh - 32px); overflow-y: auto; padding: 24px; border-radius: 16px; background: white; box-shadow: 0 20px 60px rgba(29, 29, 59, .25); color: #1d1d3b; }
    .dialog h2 { margin: 0 0 18px; font-size: 1.25rem; }
    .dialog p, .dialog li { color: #62627c; }
    .dialog ul { margin: 0; padding-left: 20px; }
    .dialog li + li { margin-top: 4px; }
    .dialog-danger { border-top: 4px solid #b43b45; }
    .dialog-fields { display: grid; gap: 16px; }
    .dialog-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; margin-top: 22px; }
    @@media (max-width: 700px) {
        .users-page { padding: 28px 16px 48px; }
        .form-grid { grid-template-columns: 1fr; }
        .panel { padding: 18px; }
        table thead { display: none; }
        table, tbody, tr, td { display: block; width: 100%; }
        tr { padding: 8px 0; border-bottom: 1px solid #eceef3; }
        td { display: grid; grid-template-columns: 105px minmax(0, 1fr); gap: 8px; padding: 7px 4px; border: 0; overflow-wrap: anywhere; }
        td::before { content: attr(data-label); color: #687083; font-size: .8rem; font-weight: 650; }
        td.row-actions { display: flex; flex-wrap: wrap; gap: 8px; text-align: left; }
        td.row-actions::before { content: none; }
        .row-actions button + button { margin-left: 0; }
        .dialog-actions button { flex: 1; }
    }
</style>

@code {
    private readonly CreateUserForm _newUser = new();
    private readonly List<UserRecord> _users = [];
    private List<JobTitleRecord> _jobTitles = [];
    private Guid? _currentUserId;
    private bool _loading = true;
    private bool _saving;
    private bool _forbidden;
    private string? _error;
    private string? _success;

    // The user being changed in the dialog, or null when the dialog is closed.
    private UserRecord? _editing;
    private EditUserForm _editForm = new();
    private string? _editError;

    // The user waiting for delete confirmation, or null when the dialog is closed.
    private UserRecord? _deleting;
    private string? _deleteError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var session = await TokenStore.GetSessionAsync();
            if (session is null)
            {
                Navigation.NavigateTo("/");
                return;
            }
            _currentUserId = session.Id;

            using var jobTitlesResponse = await SendAsync(HttpMethod.Get, "api/users/job-titles", session.AccessToken);
            if (jobTitlesResponse.StatusCode == HttpStatusCode.Forbidden)
            {
                _forbidden = true;
                return;
            }
            if (await HandleUnauthorizedAsync(jobTitlesResponse)) return;
            jobTitlesResponse.EnsureSuccessStatusCode();
            var jobTitlesEnvelope = await jobTitlesResponse.Content.ReadFromJsonAsync<ApiSuccessResponse<List<JobTitleRecord>>>();
            _jobTitles = jobTitlesEnvelope?.Data ?? [];
            await LoadUsersAsync(session.AccessToken);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Could not load user management data.");
            _error = "Gebruikers konden niet worden geladen. Controleer of de API draait.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unexpected error in user management page.");
            _error = "Er ging iets mis bij het laden van gebruikers.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadUsersAsync(string token)
    {
        using var response = await SendAsync(HttpMethod.Get, "api/users", token);
        if (await HandleUnauthorizedAsync(response)) return;
        if (response.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
            return;
        }
        response.EnsureSuccessStatusCode();
        var envelope = await response.Content.ReadFromJsonAsync<ApiSuccessResponse<List<UserRecord>>>();
        _users.Clear();
        if (envelope?.Data is not null) _users.AddRange(envelope.Data);
    }

    private async Task CreateUserAsync()
    {
        _error = _success = null;
        _saving = true;
        try
        {
            var token = await TokenStore.GetTokenAsync();
            if (string.IsNullOrWhiteSpace(token))
            {
                Navigation.NavigateTo("/");
                return;
            }
            var payload = new { _newUser.Name, _newUser.JobTitle, _newUser.Email, _newUser.Password };
            using var response = await SendAsync(HttpMethod.Post, "api/users", token, payload);
            if (await HandleUnauthorizedAsync(response)) return;
            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _forbidden = true;
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                _error = await ReadErrorAsync(response, "Gebruiker aanmaken is mislukt.");
                return;
            }
            var envelope = await response.Content.ReadFromJsonAsync<ApiSuccessResponse<UserRecord>>();
            _success = $"Gebruiker {envelope?.Data?.Name ?? _newUser.Name} is aangemaakt.";
            _newUser.Clear();
            await LoadUsersAsync(token);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Could not create user.");
            _error = "Gebruiker aanmaken is mislukt. Controleer of de API bereikbaar is.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartEdit(UserRecord user)
    {
        _error = _success = _editError = null;
        _editing = user;
        _editForm = new EditUserForm { Name = user.Name, Email = user.Email, JobTitle = user.JobTitle };
    }

    private void CancelEdit()
    {
        _editing = null;
        _editError = null;
    }

    private async Task SaveEditAsync()
    {
        if (_editing is null) return;
        _editError = null;
        _saving = true;
        try
        {
            var token = await TokenStore.GetTokenAsync();
            if (string.IsNullOrWhiteSpace(token))
            {
                Navigation.NavigateTo("/");
                return;
            }
            var payload = new { _editForm.Name, _editForm.JobTitle, _editForm.Email };
            using var response = await SendAsync(HttpMethod.Put, $"api/users/{_editing.Id}", token, payload);
            if (await HandleUnauthorizedAsync(response)) return;
            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _forbidden = true;
                _editing = null;
                return;
            }
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _editing = null;
                _error = "Deze gebruiker bestaat niet meer.";
                await LoadUsersAsync(token);
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                _editError = await ReadErrorAsync(response, "De wijzigingen konden niet worden opgeslagen.");
                return;
            }
            var envelope = await response.Content.ReadFromJsonAsync<ApiSuccessResponse<UserRecord>>();
            var updated = envelope?.Data;
            if (updated is not null)
            {
                var roleChanged = updated.Role.Name != _editing.Role.Name;
                _users[_users.IndexOf(_editing)] = updated;
                _success = $"De gegevens van {updated.Name} zijn opgeslagen."
                    + (roleChanged ? $" {updated.Name} is nu {RoleLabel(updated.Role.Name).ToLowerInvariant()}." : "");
            }
            _editing = null;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Could not update user.");
            _editError = "De wijzigingen konden niet worden opgeslagen. Controleer of de API bereikbaar is.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartDelete(UserRecord user)
    {
        _error = _success = _deleteError = null;
        _deleting = user;
    }

    private void CancelDelete()
    {
        _deleting = null;
        _deleteError = null;
    }

    private async Task DeleteUserAsync()
    {
        if (_deleting is null) return;
        _deleteError = null;
        _saving = true;
        try
        {
            var token = await TokenStore.GetTokenAsync();
            if (string.IsNullOrWhiteSpace(token))
            {
                Navigation.NavigateTo("/");
                return;
            }
            using var response = await SendAsync(HttpMethod.Delete, $"api/users/{_deleting.Id}", token);
            if (await HandleUnauthorizedAsync(response)) return;
            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _forbidden = true;
                _deleting = null;
                return;
            }
            // Not found means it is already gone, which is what the administrator wanted.
            if (!response.IsSuccessStatusCode && response.StatusCode != HttpStatusCode.NotFound)
            {
                _deleteError = await ReadErrorAsync(response, "De gebruiker kon niet worden verwijderd.");
                return;
            }
            _users.Remove(_deleting);
            _success = $"{_deleting.Name} is verwijderd.";
            _deleting = null;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Could not delete user.");
            _deleteError = "De gebruiker kon niet worden verwijderd. Controleer of de API bereikbaar is.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<bool> HandleUnauthorizedAsync(HttpResponseMessage response)
    {
        if (response.StatusCode != HttpStatusCode.Unauthorized) return false;
        await TokenStore.ClearTokenAsync();
        Navigation.NavigateTo("/");
        return true;
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response, string fallback)
    {
        var result = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
        if (result?.Errors?.Any() == true) return string.Join(" ", result.Errors);
        return result?.Message ?? fallback;
    }

    private async Task<HttpResponseMessage> SendAsync(HttpMethod method, string path, string token, object? payload = null)
    {
        var request = new HttpRequestMessage(method, path);
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        if (payload is not null) request.Content = JsonContent.Create(payload);
        return await HttpClientFactory.CreateClient("UserManagementApi").SendAsync(request);
    }

    private static bool IsAdministrator(UserRecord user) => user.Role.Name == "Administrator";

    private static string RoleLabel(string role) => role switch
    {
        "Administrator" => "Beheerder",
        "User" => "Medewerker",
        _ => role
    };

    private sealed class CreateUserForm
    {
        [Required(ErrorMessage = "Vul de naam in."), StringLength(200)]
        public string Name { get; set; } = string.Empty;
        [Required(ErrorMessage = "Kies een functie.")]
        public string JobTitle { get; set; } = string.Empty;
        [Required(ErrorMessage = "Vul het e-mailadres in."), EmailAddress(ErrorMessage = "Vul een geldig e-mailadres in."), StringLength(320)]
        public string Email { get; set; } = string.Empty;
        [Required(ErrorMessage = "Vul een wachtwoord in."), MinLength(8, ErrorMessage = "Het wachtwoord moet minimaal 8 tekens bevatten.")]
        public string Password { get; set; } = string.Empty;
        public void Clear() { Name = JobTitle = Email = Password = string.Empty; }
    }

    private sealed class EditUserForm
    {
        [Required(ErrorMessage = "Vul de naam in."), StringLength(200)]
        public string Name { get; set; } = string.Empty;
        [Required(ErrorMessage = "Vul het e-mailadres in."), EmailAddress(ErrorMessage = "Vul een geldig e-mailadres in."), StringLength(320)]
        public string Email { get; set; } = string.Empty;
        [Required(ErrorMessage = "Kies een functie.")]
        public string JobTitle { get; set; } = string.Empty;
    }

    private sealed class UserRecord
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string JobTitle { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public RoleRecord Role { get; set; } = new();
    }

    private sealed class RoleRecord
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private sealed class JobTitleRecord
    {
        public string Name { get; set; } = string.Empty;
    }
}
