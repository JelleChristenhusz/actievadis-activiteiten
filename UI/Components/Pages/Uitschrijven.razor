@page "/uitschrijven"
@rendermode InteractiveServer
@layout UI.Components.Layout.AppLayout
@using Shared.DTOs
@using UI.Service
@inject IActivityApiService ActivityApiService
@inject ILogger<Uitschrijven> Logger

@*
    Unregistering for visitors without an account (a "gast"): they have no login,
    so they prove it is their registration with their e-mail address and the code they got when registering.
*@

<PageTitle>Uitschrijven</PageTitle>

<div class="unregister-page">
    <header class="page-header">
        <h1>Uitschrijven als gast</h1>
        <p>Vul het e-mailadres in waarmee je je hebt ingeschreven, en de uitschrijfcode die je daarbij kreeg.</p>
    </header>

    @if (result is not null)
    {
        <div class="unregister-card" role="status">
            <h2>Je bent uitgeschreven</h2>
            <p>Je doet niet meer mee aan <strong>@result.ActivityName</strong>. Je plek is vrijgegeven.</p>
            <a class="unregister-link" href="/activities">Bekijk de activiteiten</a>
        </div>
    }
    else
    {
        <div class="unregister-card">
            <EditForm Model="cancellation" OnValidSubmit="CancelAsync" FormName="visitor-cancellation">
                <DataAnnotationsValidator />

                <div class="unregister-field">
                    <label for="cancel-email">E-mailadres</label>
                    <InputText id="cancel-email" type="email" class="form-control" @bind-Value="cancellation.Email" autocomplete="email" disabled="@busy" />
                    <ValidationMessage For="@(() => cancellation.Email)" />
                </div>

                <div class="unregister-field">
                    <label for="cancel-code">Uitschrijfcode</label>
                    <InputText id="cancel-code" class="form-control unregister-code" @bind-Value="cancellation.Code" autocomplete="off" placeholder="Bijvoorbeeld K7MQ-2XPA" disabled="@busy" />
                    <ValidationMessage For="@(() => cancellation.Code)" />
                </div>

                @if (errorMessage is not null)
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <button class="unregister-button" type="submit" disabled="@busy">@(busy ? "Bezig..." : "Uitschrijven")</button>
            </EditForm>
        </div>

        <p class="unregister-help">Werk je bij Covadis en heb je een account? <a href="/inloggen">Log in</a> en schrijf je uit via Mijn activiteiten.</p>
    }
</div>

<style>
    .unregister-page { max-width: 560px; margin: 0 auto; padding: 40px 24px 64px; color: #1d1d3b; }
    .unregister-page .page-header { margin-bottom: 22px; }
    .unregister-page .page-header h1 { margin: 0 0 6px; font-size: 2rem; }
    .unregister-page .page-header p, .unregister-help { margin: 0; color: #6c757d; }
    .unregister-card { padding: 24px; border: 1px solid #e9e9ef; border-radius: 14px; background: #fff; box-shadow: 0 4px 16px rgba(29, 29, 59, .06); }
    .unregister-card h2 { margin: 0 0 8px; font-size: 1.3rem; }
    .unregister-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
    .unregister-field label { font-weight: 650; }
    .unregister-field .form-control { min-height: 44px; border: 1px solid #cfd3dd; border-radius: 8px; padding: 9px 11px; }
    .unregister-code { text-transform: uppercase; letter-spacing: .08em; }
    .unregister-button { width: 100%; min-height: 44px; border: 1px solid #b43b45; border-radius: 10px; background: #b43b45; color: #fff; font-weight: 650; cursor: pointer; }
    .unregister-button:hover:not(:disabled) { background: #9b2630; }
    .unregister-button:disabled { opacity: .6; cursor: wait; }
    .unregister-button:focus-visible, .unregister-link:focus-visible { outline: 3px solid #f5a623; outline-offset: 3px; }
    .unregister-link { display: inline-block; margin-top: 8px; color: #1d1d3b; font-weight: 650; }
    .unregister-help { margin-top: 18px; font-size: .9rem; }
    @@media (max-width: 575px) {
        .unregister-page { padding: 24px 16px 40px; }
        .unregister-card { padding: 18px; }
    }
</style>

@code {
    private CancelVisitorRegistrationDto cancellation = new();
    private VisitorCancellationResultDto? result;
    private string? errorMessage;
    private bool busy;

    private async Task CancelAsync()
    {
        if (busy) return;
        busy = true;
        errorMessage = null;
        try
        {
            result = await ActivityApiService.CancelVisitorRegistrationAsync(cancellation);
        }
        catch (HttpRequestException exception)
        {
            // The API explains what is wrong, for example that the code does not match or the activity has started.
            Logger.LogInformation(exception, "Visitor cancellation was refused.");
            errorMessage = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
